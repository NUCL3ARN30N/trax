// UI-only state shared between pages and the main window (menus, dialogs).

export global Ui {
    // Track context menu.
    in-out property <string> menu-list;
    in-out property <int> menu-index;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <int> menu-serial: 0;

    // Dialogs: 0 none, 1 new playlist, 2 rename playlist, 3 new playlist with track, 4 delete playlist,
    // 5 edit track, 6 edit playlist, 7 find on Spotify, 8 edit artist, 9 share playlist, 10 import playlist (code or link),
    // 11 clear audio cache
    in-out property <int> dialog: 0;
    in-out property <string> dialog-text;

    in-out property <bool> show-queue: false;
    in-out property <bool> show-eq: false;
    // Lyrics beside the song list, and over the fullscreen player.
    in-out property <bool> show-lyrics: false;
    in-out property <bool> fs-lyrics: false;

    public function open-menu(list: string, index: int, x: length, y: length) {
        self.menu-list = list;
        self.menu-index = index;
        self.menu-x = x;
        self.menu-y = y;
        self.menu-serial += 1;
    }
}
